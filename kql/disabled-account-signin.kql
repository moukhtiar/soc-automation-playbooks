// Attempts to sign in to disabled accounts (Entra error 50057)
// Based on the Microsoft Sentinel template "Attempts to sign in to disabled accounts".
// threshold = number of DISTINCT applications the user tried within the lookback window.
//   Template default: 3  (better production starting point, fewer false positives)
//   Lab value:        1  (so a single test sign-in fires the rule)
let threshold = 1;

let aadFunc = (tableName:string){
table(tableName)
| where ResultType == "50057"
| summarize StartTime = min(TimeGenerated), EndTime = max(TimeGenerated),
            applicationCount = dcount(AppDisplayName),
            applicationSet = make_set(AppDisplayName),
            count() by UserPrincipalName, IPAddress, Type
| where applicationCount >= threshold
| extend Name = tostring(split(UserPrincipalName,'@',0)[0]),
         UPNSuffix = tostring(split(UserPrincipalName,'@',1)[0])
};

let aadSignin = aadFunc("SigninLogs");
let aadNonInt = aadFunc("AADNonInteractiveUserSignInLogs");
union isfuzzy=true aadSignin, aadNonInt
